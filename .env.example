# Copy this file to .env and fill in your API keys.
# The .env file is loaded by docker-compose and agent/agent.py.

# Braintrust API key — create one at https://www.braintrust.dev/app/settings?tab=api-keys
BRAINTRUST_API_KEY=your_braintrust_api_key_here

# OpenAI API key — used by the OpenAI Agents SDK to call the OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
